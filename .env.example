# Identificação pública do projeto Supabase
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com projetos Supabase que ainda usam o nome legado
SUPABASE_ANON_KEY=

# Somente no runtime da Edge Function; nunca usar no frontend
SUPABASE_SERVICE_ROLE_KEY=

# GestãoClick — somente no runtime da Edge Function
GC_ACCESS_TOKEN=
GC_SECRET_TOKEN=
# Sessão técnica do app GC, necessária porque a API pública descarta ICMS_orig.
# Manter somente como secret da Edge Function; nunca expor no frontend.
GC_WEB_TOKEN=
# Fallback para projetos que usam esta nomenclatura
GC_SECRET_ACCESS_TOKEN=

# Auvo — somente no runtime da Edge Function
AUVO_API_KEY=
AUVO_USER_TOKEN=
# Fallbacks aceitos pelo cliente compartilhado
AUVO_APP_KEY=
AUVO_API_TOKEN=
AUVO_TOKEN=
